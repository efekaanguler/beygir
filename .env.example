GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Keys in the same Groq organization must use the same quota group.
GROQ_QUOTA_GROUP_1=groq
GROQ_QUOTA_GROUP_2=groq

# Bedrock on-demand bearer token. Short-lived keys are scoped to one region.
BEDROCK_REGION=eu-north-1
AWS_BEARER_TOKEN_BEDROCK=

# Batch uses the standard AWS SDK credential chain, independently of the bearer.
# AWS_PROFILE=
BEDROCK_BATCH_BUCKET=
BEDROCK_BATCH_ROLE_ARN=
